# ARCHIVO:.gitignore
# RUTA:.gitignore (raíz del repo bookrm/)
# DESCRIPCIÓN: Evita versionar secretos (.env con GEMINI_API_KEY y DB_PASS), dependencias, builds de Vite/Node, logs y artefactos de OS/IDE. Cierra hallazgo README §9.
# Stack: MARN — backend Node Express 5 + frontend Vite 5

# ── Secretos — NUNCA versionar (README §9) ──
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
**/.env
**/.env.local
!**/.env.example
backend/.env
frontend/.env

# ── Dependencias ──
node_modules/
.pnp/
.pnp.js
yarn-error.log
pnpm-debug.log*

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*

# ── Builds ──
dist/
build/
frontend/dist/
frontend/build/
backend/dist/
.vite/
*.tsbuildinfo

# ── Prisma — mantener schema.prisma y migrations, ignorar solo artefactos generados fuera de node_modules ──
prisma/.client/
# no ignorar backend/prisma/schema.prisma
# no ignorar backend/prisma/migrations/

# ── Testing / Coverage ──
coverage/
.nyc_output/
.nyc_output
junit.xml

# ── OS ──
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/

# ── Temp ──
tmp/
temp/
*.tmp
*.temp
.cache/

# ── Opcional: dumps locales con datos reales (mantener schema de referencia si lo necesitas) ──
# *.dump.sql
# dump.rdb