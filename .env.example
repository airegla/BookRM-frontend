# BOOK(RM) - Frontend - Plantilla de variables de entorno
# Copiá este archivo a `.env` y completá.

# Base de la API (por defecto http://localhost:3000/api)
VITE_API_URL=http://localhost:3000/api

# API key compartida (mismo valor que API_KEY del backend)
VITE_API_KEY=

# Modo debug (DebugTag): true = cada bloque muestra su identificación.
VITE_DEBUG_MODE=false
